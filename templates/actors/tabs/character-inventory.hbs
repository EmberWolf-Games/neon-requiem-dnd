<section class="tab {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">

    {{!-- Encumbrance & Containers --}}
    <div class="top">

        {{!-- Encumbrance --}}
        <div class="encumbrance card">
            {{> "systems/neon-requiem-dnd/templates/inventory/encumbrance.hbs" encumbrance=system.attributes.encumbrance
                hasBreakpoints=true }}
            <div class="info">
                <div class="strength">
                    <span class="label">{{ localize "DND5E.AbilityStr" }}</span>
                    <span class="value">{{ system.abilities.str.value }}</span>
                </div>
                <div class="size">
                    <span class="label">{{ localize "DND5E.Size" }}</span>
                    <span class="value" aria-label="{{ size.label }}">{{ size.abbr }}</span>
                </div>
                <div class="multiplier">
                    <span class="label">{{ localize "DND5E.Multiplier" }}</span>
                    <span class="value">
                        <span class="sign">&times;</span>
                        {{ size.mod }}
                    </span>
                </div>
            </div>
        </div>

        {{!-- Containers --}}
        {{> "systems/neon-requiem-dnd/templates/inventory/containers.hbs" }}

    </div>

    <section class="neon-slot-prototype" aria-labelledby="neon-slots-heading">
        <h2 id="neon-slots-heading">Neon Requiem — Loadout Preview</h2>
        <p>Read-only prototype: example topology only; no equipment or augmentations are installed here.</p>
        <h3>Overview</h3>
        <p>Use the existing Details and Biography tabs for saved character information. Neon Requiem identity fields are planned and are not saved here.</p>
        <h3>Combat</h3>
        <p>Existing hit points, defenses, attacks, and rolls remain in the inherited sheet controls.</p>
        <h3>Loadout</h3>
        <p>Your actual owned inventory appears below this preview. The positions shown here are not assigned to those items.</p>
        <h3>Physical equipment positions</h3>
        <ul class="neon-slot-list">
            {{#each neonPrototype.positions}}
            <li><span>{{label}}</span> <span>Capacity: {{capacity}}</span></li>
            {{/each}}
        </ul>
        <h3>Body-owned Augmentation slots</h3>
        <ul class="neon-slot-list">
            {{#each neonPrototype.categories}}
            <li><span class="neon-slot-indicator neon-slot-{{id}}" aria-hidden="true"></span>
                <span>{{label}} ({{colorName}})</span></li>
            {{/each}}
        </ul>
        <h3>Example Cyberware expansion</h3>
        <p>Example only: a Cyberware item may grant an Interface (Cyan) expansion slot. This is not actor data.</p>
        <p>Equipment attachment sockets are separate from body Augmentation slots. Equipment does not change token appearance.</p>
        <h3>Hacks — planned</h3>
        <p>Hack installation and software abilities are not implemented.</p>
    </section>
    {{> "systems/neon-requiem-dnd/templates/inventory/inventory.hbs" }}
</section>
